# 环境
NODE_ENV=development

# 接口前缀
VITE_API_URL=http://127.0.0.1:10001/
VITE_WEBSOCKET_URL=http://127.0.0.1:10001/dsh-admin-api/websocket/
# VITE_API_URL=http://demo.dianhuiyun.com.cn/
# proxy 跨域代理(在vite.config.ts中配置)
# VITE_API_URL=/dev

# 打包路径
VITE_BASE_PATH=./

# 是否删除debugger
VITE_DROP_DEBUGGER=false

# 是否删除console.log
VITE_DROP_CONSOLE=false

# 是否sourcemap
VITE_SOURCEMAP=true

# 输出路径
VITE_OUT_DIR=dist
