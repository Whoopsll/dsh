  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "uni-app",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  },
  "tabBar": {
    "color": "#333",
    "selectedColor": "#1dc09d",
    "backgroundColor": "#fff",
    "borderStyle": "black",
    "style": {
          "boxShadow": "0px -2px 10px rgba(0,0,0,0.2)"
        },
    "list": [
      {
        "text": "读书汇",
        "pagePath": "pages/index/index",
        "iconPath": "static/tabs/icon_index_unselect.png",
        "selectedIconPath": "static/tabs/icon_index_selected.png"
      },
      {
        "text": "关注",
        "pagePath": "pages/follow/follow",
        "iconPath": "static/tabs/icon_follow_unselect.png",
        "selectedIconPath": "static/tabs/icon_follow_selected.png"
      },
      {
        "text": "我的",
        "pagePath": "pages/profile/profile",
        "iconPath": "static/tabs/icon_mine_unselect.png",
        "selectedIconPath": "static/tabs/icon_mine_selected.png"
      }
    ]
  }
}
