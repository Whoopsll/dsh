      "path" : "components/SafeAreaWrapper/SafeAreaWrapper",
      "style" :
      {
        "navigationBarTitleText" : "",
        "enablePullDownRefresh" : false
      }
    },
    {
      "path" : "pages/initProfile/initProfile",
      "style" :
      {
         "disableScroll": true,
        "navigationStyle": "custom",
        "navigationBarTitleText" : "",
        "enablePullDownRefresh" : false
      }
    }
